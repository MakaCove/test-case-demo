RUNNER_HOST=0.0.0.0
RUNNER_PORT=18081
RUNNER_TOKEN=

# DashScope / OpenAI 兼容（与 browser-use ChatOpenAI 一致）
# 复制为 .env 后填写真实密钥，勿提交 .env
DASHSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
DASHSCOPE_API_KEY=your-api-key-here
QWEN_MODEL=qwen3.5-plus

# browser-use 运行参数
HEADLESS=false
CHROME_PATH=

# 有界面（HEADLESS=false）时：代码里已默认用 Chrome --start-maximized，一般不用配下面。
# 仅在有需要时取消注释并写入你的 .env（改完重启 uvicorn）：
#   BROWSER_DISABLE_START_MAXIMIZED=1  — 不要最大化，改用接近整屏的固定 --window-size
#   BROWSER_WINDOW_SIZE=1920x1080      — 或指定固定宽高（与「默认最大化」二选一）
#   BROWSER_WINDOW_WIDTH / BROWSER_WINDOW_HEIGHT — 同上，拆成两个变量也行
#   BROWSER_KEEP_DISABLE_WINDOW_ACTIVATION=1 — 保留 browser-use 默认的 --disable-window-activation（若去掉后你不希望窗口抢焦点可开）
